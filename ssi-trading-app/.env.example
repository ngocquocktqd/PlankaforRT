# Sao chép thành .env rồi điền. KHÔNG commit .env (đã gitignore).
# Không có các biến này → app chạy MOCK (giá giả, lệnh giấy) — an toàn để phát triển.

SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=
# Private key RS256 để KÝ lệnh giao dịch (chỉ cần khi bật đặt lệnh thật)
SSI_PRIVATE_KEY=
SSI_ACCOUNT_NO=

# AN TOÀN: đặt lệnh THẬT chỉ khi =1 VÀ có đủ credential + private_key + account.
# Mặc định 0 = chỉ paper trading.
SSI_TRADING_ENABLED=0

# DB (mặc định SQLite local)
# DB_URL=sqlite:///data.db
